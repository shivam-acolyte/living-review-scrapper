# ==============================================================================
# Database Configuration for Property & Reviews Seeder
# Copy this file to .env and fill in your values. NEVER commit .env!
# ==============================================================================

# Database Engine: 'postgres' (default) or 'sqlite'
DB_TYPE=postgres

# Option A: Full Connection String (e.g. Supabase, Neon, RDS, Docker, or Local Postgres)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Option B: Individual Connection Parameters (used if DATABASE_URL is not provided)
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Target Table Names in Database
BUSINESS_TABLE=house_business_mappings
REVIEWS_TABLE=new_house_reviews

# SQLite Local Database (used if DB_TYPE=sqlite or fallback)
SQLITE_PATH=seeded_properties.db
