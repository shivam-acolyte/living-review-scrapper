# Database Engine: 'postgres' (default) or 'sqlite' (for local testing without postgres)
DB_TYPE=postgres

# Option A: Full Connection String (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Option B: Individual PostgreSQL Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Pipeline Table Names
PROPERTIES_TABLE=properties
REVIEWS_TABLE=property_reviews

# Scraping & Delay Settings
MAX_REVIEWS_PER_PROPERTY=10
REQUEST_DELAY_SECONDS=1.5
MAX_RETRIES=3
